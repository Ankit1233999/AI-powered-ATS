PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hireai
JWT_SECRET=replace-with-a-long-random-secret
RECRUITER_INVITE_CODE=replace-with-a-private-code
CLIENT_ORIGIN=http://localhost:5173
AWS_REGION=ap-south-1
AWS_S3_BUCKET=your-private-resume-bucket
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional transactional email. Status emails are skipped when SMTP is not configured.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Hiring Team <no-reply@example.com>
EMAIL_FROM_NAME=Hiring Team
